# Backend environment variables. Keep this file as an example only; do not add secrets.
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app-domain.example
NODE_ENV=production
# Server-only secrets. Never prefix these with VITE_ or expose them to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
